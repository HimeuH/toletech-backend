{
  "info": {
    "name": "Storages API",
    "description": "Collection de requêtes pour gérer les storages",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Storage",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"owner\": \"{{userId}}\",\n  \"location\": \"Dakar Plateau\",\n  \"capacity\": 200,\n  \"availableFrom\": \"2025-09-01T00:00:00Z\",\n  \"availableTo\": \"2025-12-31T23:59:59Z\",\n  \"productType\": \"Céréales\",\n  \"isAvailable\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/storages", "host": ["{{baseUrl}}"], "path": ["storages"] }
      },
      "response": [
        {
          "code": 201,
          "name": "Created",
          "body": "{\n  \"_id\": \"64d3a0d12345abcd6789ef01\",\n  \"owner\": \"{{userId}}\",\n  \"location\": \"Dakar Plateau\",\n  \"capacity\": 200,\n  \"availableFrom\": \"2025-09-01T00:00:00Z\",\n  \"availableTo\": \"2025-12-31T23:59:59Z\",\n  \"productType\": \"Céréales\",\n  \"isAvailable\": true,\n  \"createdAt\": \"2025-08-25T14:00:00Z\",\n  \"updatedAt\": \"2025-08-25T14:00:00Z\"\n}"
        }
      ]
    },
    {
      "name": "Get All Storages",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/storages", "host": ["{{baseUrl}}"], "path": ["storages"] }
      },
      "response": [
        {
          "code": 200,
          "name": "OK",
          "body": "[ { \"_id\": \"64d3a0d12345abcd6789ef01\", \"location\": \"Dakar Plateau\", \"capacity\": 200, \"productType\": \"Céréales\" } ]"
        }
      ]
    },
    {
      "name": "Get Storage by ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/storages/{{storageId}}", "host": ["{{baseUrl}}"], "path": ["storages", "{{storageId}}"] }
      },
      "response": [
        {
          "code": 200,
          "name": "OK",
          "body": "{ \"_id\": \"{{storageId}}\", \"location\": \"Dakar Plateau\", \"capacity\": 200 }"
        },
        {
          "code": 404,
          "name": "Not Found",
          "body": "{ \"message\": \"Storage not found\" }"
        }
      ]
    },
    {
      "name": "Update Storage",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"capacity\": 300,\n  \"isAvailable\": false\n}"
        },
        "url": { "raw": "{{baseUrl}}/storages/{{storageId}}", "host": ["{{baseUrl}}"], "path": ["storages", "{{storageId}}"] }
      },
      "response": [
        {
          "code": 200,
          "name": "Updated",
          "body": "{ \"_id\": \"{{storageId}}\", \"capacity\": 300, \"isAvailable\": false }"
        }
      ]
    },
    {
      "name": "Delete Storage",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/storages/{{storageId}}", "host": ["{{baseUrl}}"], "path": ["storages", "{{storageId}}"] }
      },
      "response": [
        {
          "code": 200,
          "name": "Deleted",
          "body": "{ \"message\": \"Storage deleted successfully\" }"
        },
        {
          "code": 404,
          "name": "Not Found",
          "body": "{ \"message\": \"Storage not found\" }"
        }
      ]
    },
    {
      "name": "Get Storages by Owner",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/storages/owner/{{userId}}", "host": ["{{baseUrl}}"], "path": ["storages", "owner", "{{userId}}"] }
      },
      "response": [{ "code": 200, "body": "[ { \"_id\": \"64d3a0d12345abcd6789ef01\", \"owner\": \"{{userId}}\" } ]" }]
    },
    {
      "name": "Get Storages by Status",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/storages/status/{{status}}", "host": ["{{baseUrl}}"], "path": ["storages", "status", "{{status}}"] }
      },
      "response": [
        { "code": 200, "body": "[ { \"_id\": \"64d3a0d12345abcd6789ef01\", \"isAvailable\": true } ]" }
      ]
    },
    {
      "name": "Search Storages",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/storages/search?location=Dakar&productType=Céréales&from=2025-09-01&to=2025-12-31",
          "host": ["{{baseUrl}}"],
          "path": ["storages", "search"],
          "query": [
            { "key": "location", "value": "Dakar" },
            { "key": "productType", "value": "Céréales" },
            { "key": "from", "value": "2025-09-01" },
            { "key": "to", "value": "2025-12-31" }
          ]
        }
      },
      "response": [
        { "code": 200, "body": "[ { \"location\": \"Dakar\", \"productType\": \"Céréales\", \"isAvailable\": true } ]" }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "userId", "value": "64d39f912345abcd6789ef00" },
    { "key": "storageId", "value": "64d3a0d12345abcd6789ef01" },
    { "key": "status", "value": "true" }
  ]
}