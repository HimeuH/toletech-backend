{
  "info": {
    "name": "Toletech Full API",
    "description": "Full API Collection for Users, Storages, Reservations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "USERS",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@test.com\",\n  \"password\": \"123456\",\n  \"phone\": \"771234567\",\n  \"role\": \"AGRICULTEUR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/search?query=alice",
              "host": ["{{baseUrl}}"],
              "path": ["users", "search"],
              "query": [{ "key": "query", "value": "alice" }]
            }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated\",\n  \"email\": \"alice.new@test.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "STORAGES",
      "item": [
        {
          "name": "Create Storage",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"{{userId}}\",\n  \"location\": \"Dakar Plateau\",\n  \"capacity\": 200,\n  \"capacityUnit\": \"M2\",\n  \"availableFrom\": \"2026-02-01T00:00:00Z\",\n  \"availableTo\": \"2026-05-01T00:00:00Z\",\n  \"productType\": \"Cereales\",\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/storages",
              "host": ["{{baseUrl}}"],
              "path": ["storages"]
            }
          }
        },
        {
          "name": "Get All Storages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/storages",
              "host": ["{{baseUrl}}"],
              "path": ["storages"]
            }
          }
        },
        {
          "name": "Search Storages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/storages/search?location=dakar&productType=cereales",
              "host": ["{{baseUrl}}"],
              "path": ["storages", "search"],
              "query": [
                { "key": "location", "value": "dakar" },
                { "key": "productType", "value": "cereales" }
              ]
            }
          }
        },
        {
          "name": "Get Storage By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/storages/{{storageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["storages", "{{storageId}}"]
            }
          }
        },
        {
          "name": "Update Storage",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 300,\n  \"isAvailable\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/storages/{{storageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["storages", "{{storageId}}"]
            }
          }
        },
        {
          "name": "Delete Storage",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/storages/{{storageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["storages", "{{storageId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "RESERVATIONS",
      "item": [
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storage\": \"{{storageId}}\",\n  \"user\": \"{{userId}}\",\n  \"reservedFrom\": \"2026-02-10\",\n  \"reservedTo\": \"2026-03-01\",\n  \"status\": \"EN_ATTENTE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["reservations"]
            }
          }
        },
        {
          "name": "Get All Reservations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["reservations"]
            }
          }
        },
        {
          "name": "Search Reservations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reservations/search?status=EN_ATTENTE",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "search"],
              "query": [{ "key": "status", "value": "EN_ATTENTE" }]
            }
          }
        },
        {
          "name": "Get Reservation By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "{{reservationId}}"]
            }
          }
        },
        {
          "name": "Update Reservation",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMÉ\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "{{reservationId}}"]
            }
          }
        },
        {
          "name": "Delete Reservation",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "{{reservationId}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "userId", "value": "" },
    { "key": "storageId", "value": "" },
    { "key": "reservationId", "value": "" }
  ]
}
