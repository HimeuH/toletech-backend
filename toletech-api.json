    {
      "name": "DASHBOARD",
      "item": [
        {
          "name": "Farmer Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/dashboard/farmer", "host": ["{{baseUrl}}"], "path": ["dashboard", "farmer"] },
            "description": "Role: AGRICULTEUR. Returns:\n- activeReservations: count of APPROUVÉ/CONFIRMÉ reservations\n- pendingPayments: billings with status PENDING\n- recentHistory: last 10 reservations"
          },
          "response": []
        },
        {
          "name": "Owner Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/dashboard/owner", "host": ["{{baseUrl}}"], "path": ["dashboard", "owner"] },
            "description": "Roles: PROPRIETAIRE, TRANSFORMATEUR. Returns:\n- totalStorages, totalSpaces, occupiedSpaces\n- occupationRate (percentage)\n- pendingRequests: count of EN_ATTENTE reservations\n- monthlyRevenue: sum of PAID billings for current month"
          },
          "response": []
