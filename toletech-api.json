              "raw": "{{baseUrl}}/storages?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["storages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Public. Returns paginated list of all storages (any availability status).\nResponse: { success, data: { data[], count, totalCount, totalPages, currentPage }, message }"
          },
