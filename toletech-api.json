            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/billings/{{billingId}}/status", "host": ["{{baseUrl}}"], "path": ["billings", "{{billingId}}", "status"] },
            "description": "Role: ADMIN only. Updates billing status.\nstatus enum: PENDING | PAID | CANCELLED"
          },
          "response": []
        }
      ]
    },
