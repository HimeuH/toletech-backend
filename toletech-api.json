    },
    {
      "name": "STORAGE SPACES",
      "item": [
        {
          "name": "Create Space",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cellule A\",\n  \"capacity\": 50,\n  \"capacityUnit\": \"TONNES\",\n  \"price\": 15000,\n  \"pricingPeriod\": \"MONTHLY\",\n  \"availableFrom\": \"2026-03-01T00:00:00Z\",\n  \"availableTo\": \"2026-12-31T00:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/storages/{{storageId}}/spaces", "host": ["{{baseUrl}}"], "path": ["storages", "{{storageId}}", "spaces"] },
            "description": "Roles: PROPRIETAIRE, TRANSFORMATEUR, AGENT, ADMIN. Caller must own the parent storage (ADMIN bypasses).\n\ncapacityUnit enum: M2 | HA | L | M3 | TONNES\npricingPeriod enum: DAILY | MONTHLY | SEASONAL\nstatus enum: DISPONIBLE | OCCUPÉ | MAINTENANCE (default: DISPONIBLE)"
          },
          "response": []
        },
        {
          "name": "Get Spaces By Storage",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/storages/{{storageId}}/spaces", "host": ["{{baseUrl}}"], "path": ["storages", "{{storageId}}", "spaces"] },
            "description": "Public. Returns all spaces belonging to a storage."
          },
          "response": []
        },
        {
          "name": "Update Space",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 18000,\n  \"status\": \"MAINTENANCE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/storages/{{storageId}}/spaces/{{spaceId}}", "host": ["{{baseUrl}}"], "path": ["storages", "{{storageId}}", "spaces", "{{spaceId}}"] },
            "description": "Roles: PROPRIETAIRE, TRANSFORMATEUR, ADMIN."
          },
          "response": []
        },
        {
          "name": "Delete Space",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/storages/{{storageId}}/spaces/{{spaceId}}", "host": ["{{baseUrl}}"], "path": ["storages", "{{storageId}}", "spaces", "{{spaceId}}"] },
            "description": "Roles: PROPRIETAIRE, TRANSFORMATEUR, ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "RESERVATIONS",
      "item": [
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storage\": \"{{storageId}}\",\n  \"reservedFrom\": \"2026-03-10\",\n  \"reservedTo\": \"2026-04-10\",\n  \"quantity\": 10,\n  \"quantityUnit\": \"TONNES\",\n  \"notes\": \"Stockage de riz paddy\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] },
            "description": "Roles: AGRICULTEUR, AGENT, ADMIN.\nAgent: include onBehalfOf (farmerId) to create on behalf of a farmer.\n\nquantityUnit enum: KG | TONNES | SACS | LITRES\nStatus auto-set to EN_ATTENTE on create.\nTriggers in-app notification to storage owner."
          },
          "response": []
        },
        {
          "name": "Get All Reservations (Admin/Agent)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/reservations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["reservations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Roles: ADMIN, AGENT. Returns all reservations paginated."
          },
          "response": []
        },
        {
          "name": "Get My Reservations (Farmer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/reservations/my?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "my"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Role: AGRICULTEUR. Returns only the authenticated farmer's reservations."
          },
          "response": []
        },
        {
          "name": "Get Owner Reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/reservations/owner?status=EN_ATTENTE&storageId={{storageId}}&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "owner"],
              "query": [
                { "key": "status", "value": "EN_ATTENTE", "description": "Filter by status (optional)" },
                { "key": "storageId", "value": "{{storageId}}", "description": "Filter by specific storage (optional)" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Roles: PROPRIETAIRE, TRANSFORMATEUR, ADMIN. Returns all reservations for the caller's storages. Filterable by status and storageId."
          },
          "response": []
        },
        {
          "name": "Search Reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/reservations/search?status=EN_ATTENTE&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "search"],
              "query": [
                { "key": "status", "value": "EN_ATTENTE", "description": "EN_ATTENTE | APPROUVÉ | REJETÉ | CONFIRMÉ | ANNULÉ" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Authenticated. Searches reservations by status or other query params."
          },
          "response": []
        },
        {
          "name": "Get Reservation By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] },
            "description": "Authenticated. Returns full reservation including statusHistory array."
          },
          "response": []
        },
        {
          "name": "Update Reservation (Farmer cancel)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ANNULÉ\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] },
            "description": "Authenticated. Farmer can only set status to ANNULÉ (if currently EN_ATTENTE or APPROUVÉ).\nAdmin has full transition control:\n  EN_ATTENTE → APPROUVÉ | REJETÉ | ANNULÉ\n  APPROUVÉ → CONFIRMÉ | ANNULÉ\n\nStatus change to CONFIRMÉ triggers auto-billing generation."
          },
          "response": []
        },
        {
          "name": "Respond to Reservation (Owner approve/reject)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"message\": \"Réservation approuvée, accès disponible dès le 10 mars.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}/respond", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}", "respond"] },
            "description": "Roles: PROPRIETAIRE, TRANSFORMATEUR, ADMIN. Caller must own the storage.\nReservation must be EN_ATTENTE.\n\naction: \"approve\" → status becomes APPROUVÉ\naction: \"reject\" → status becomes REJETÉ\n\nTriggers SMS + in-app notification to farmer."
          },
          "response": []
        },
        {
          "name": "Delete Reservation (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] },
            "description": "Role: ADMIN only."
          },
          "response": []
        }
      ]
    },
