            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Entrepôt Dakar Centre\",\n  \"storageType\": \"HANGAR\",\n  \"address\": {\n    \"street\": \"Rue 10\",\n    \"city\": \"Dakar\",\n    \"region\": \"Dakar\",\n    \"country\": \"Sénégal\"\n  },\n  \"gpsCoordinates\": {\n    \"type\": \"Point\",\n    \"coordinates\": [-17.4441, 14.6928]\n  },\n  \"capacity\": 500,\n  \"capacityUnit\": \"M2\",\n  \"costPerKgPerDay\": 5,\n  \"description\": \"Grand entrepôt sécurisé\",\n  \"facilities\": [\"electricity\", \"security\", \"ventilation\"],\n  \"accessHours\": \"08:00-18:00\",\n  \"availableFrom\": \"2026-03-01T00:00:00Z\",\n  \"availableTo\": \"2026-12-31T00:00:00Z\",\n  \"isAvailable\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/storages", "host": ["{{baseUrl}}"], "path": ["storages"] },
            "description": "Roles: PROPRIETAIRE, TRANSFORMATEUR, AGENT, ADMIN.\nAgent: include ownerId to create on behalf of an owner (PROPRIETAIRE/TRANSFORMATEUR).\n\nstorageType enum: SILO | HANGAR | CHAMBRE_FROIDE\ncapacityUnit enum: M2 | HA | L | M3 | TONNES\n\nFor photo upload use multipart/form-data with files field 'photos' (max 10)."
