{
  "info": {
    "_postman_id": "12345678-1234-1234-1234-123456789abc",
    "name": "Toletech Full API",
    "description": "Full API Collection — Auth, Storages, Storage Spaces, Reservations, Billings, Notifications, Agent, Dashboard\n\nAuthentication: all protected endpoints accept the JWT token via either:\n1. Cookie: `token` (set automatically by the server on login / verify-otp — used by web clients with withCredentials)\n2. Header: `Authorization: Bearer <token>` (used in Postman via the {{token}} variable)\n\nThe server checks the cookie first, then falls back to the Bearer header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Diallo\",\n  \"email\": \"alice@test.com\",\n  \"password\": \"123456\",\n  \"phone\": \"771234567\",\n  \"role\": \"AGRICULTEUR\",\n  \"location\": \"Dakar\",\n  \"exploitationType\": \"Maraîchage\",\n  \"crops\": [\"tomates\", \"oignons\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Creates a new user. Returns success message and sends OTP via SMS. Does not return JWT — call /auth/verify-otp next.\n\nRoles: AGRICULTEUR, PROPRIETAIRE, TRANSFORMATEUR, AGENT, ADMIN\nRole-specific body fields:\n- AGRICULTEUR: location, exploitationType, crops[]\n- PROPRIETAIRE/TRANSFORMATEUR: location, companyName, companyRegistration, contactPerson\n- AGENT: assignedRegion"
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"771234567\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth", "verify-otp"] },
            "description": "Verifies the OTP sent on registration. On success sets isVerified=true, returns JWT token, and sets `token` cookie (httpOnly). Store the token in {{token}} for subsequent Postman requests."
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"771234567\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["auth", "resend-otp"] },
            "description": "Generates and resends a new OTP to the given phone number."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"771234567\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Accepts { phone, password } or { email, password }. Returns JWT token and sets `token` cookie (httpOnly).\nStore the token in {{token}} variable for Bearer header use in Postman.\n403 if isVerified=false or isActive=false."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Clears the auth cookie and returns success."
          },
          "response": []
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Returns the authenticated user's full profile including role-specific fields."
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated\",\n  \"location\": \"Saint-Louis\",\n  \"crops\": [\"riz\", \"arachides\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/me/update", "host": ["{{baseUrl}}"], "path": ["auth", "me", "update"] },
            "description": "Updates profile fields. If phone is changed triggers OTP verification flow — phone is stored as pendingPhone until verified via /auth/verify-phone-change."
          },
          "response": []
        },
        {
          "name": "Verify Phone Change",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"654321\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-phone-change", "host": ["{{baseUrl}}"], "path": ["auth", "verify-phone-change"] },
            "description": "Verifies OTP for phone number change. Copies pendingPhone → phone on success."
          },
          "response": []
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"123456\",\n  \"password\": \"newpass123\",\n  \"confirmPassword\": \"newpass123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/password/update", "host": ["{{baseUrl}}"], "path": ["auth", "password", "update"] },
            "description": "Changes password for authenticated user."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+221770000001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/password/forgot", "host": ["{{baseUrl}}"], "path": ["auth", "password", "forgot"] },
            "description": "Step 1 of 3 — Phone-based password reset.\nSends a 6-digit OTP via SMS to the provided phone number. OTP is valid for 10 minutes.\n\nNext: POST /auth/password/verify-reset-otp"
          },
          "response": []
        },
        {
          "name": "Verify Reset OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+221770000001\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/password/verify-reset-otp", "host": ["{{baseUrl}}"], "path": ["auth", "password", "verify-reset-otp"] },
            "description": "Step 2 of 3 — Verifies the reset OTP.\nOn success returns a resetToken valid for 15 minutes. Store it in {{resetToken}} for the next step.\n\nResponse: { success, resetToken, message }\n\nNext: PUT /auth/password/reset"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"password\": \"NewPass123!\",\n  \"confirmPassword\": \"NewPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/password/reset", "host": ["{{baseUrl}}"], "path": ["auth", "password", "reset"] },
            "description": "Step 3 of 3 — Sets the new password using the resetToken from step 2.\nOn success returns a JWT (auto-login) and sets the auth cookie.\n\nresetToken expires after 15 minutes."
          },
          "response": []
        }
      ]
    },
    {
