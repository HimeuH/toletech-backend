{
  "info": {
    "name": "Reservations API",
    "description": "Collection de requêtes pour gérer les réservations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Reservation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"storage\": \"{{storageId}}\",\n  \"reservedFrom\": \"2025-09-01T08:00:00Z\",\n  \"reservedTo\": \"2025-09-10T18:00:00Z\",\n  \"status\": \"EN_ATTENTE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
      },
      "response": [
        {
          "code": 201,
          "name": "Created",
          "body": "{\n  \"_id\": \"64d3b0f12345abcd6789ef11\",\n  \"storage\": \"{{storageId}}\",\n  \"user\": \"{{userId}}\",\n  \"reservedFrom\": \"2025-09-01T08:00:00Z\",\n  \"reservedTo\": \"2025-09-10T18:00:00Z\",\n  \"status\": \"EN_ATTENTE\",\n  \"createdAt\": \"2025-08-25T14:30:00Z\",\n  \"updatedAt\": \"2025-08-25T14:30:00Z\"\n}"
        }
      ]
    },
    {
      "name": "Get All Reservations",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
      },
      "response": [
        {
          "code": 200,
          "name": "OK",
          "body": "[ { \"_id\": \"64d3b0f12345abcd6789ef11\", \"storage\": {\"_id\": \"{{storageId}}\"}, \"user\": {\"_id\": \"{{userId}}\", \"name\": \"Alioune\"}, \"status\": \"EN_ATTENTE\" } ]"
        }
      ]
    },
    {
      "name": "Get Reservation by ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] }
      },
      "response": [
        {
          "code": 200,
          "name": "OK",
          "body": "{ \"_id\": \"{{reservationId}}\", \"storage\": {\"_id\": \"{{storageId}}\"}, \"user\": {\"_id\": \"{{userId}}\", \"name\": \"Alioune\"}, \"status\": \"EN_ATTENTE\" }"
        },
        {
          "code": 404,
          "name": "Not Found",
          "body": "{ \"error\": \"Not found\" }"
        }
      ]
    },
    {
      "name": "Update Reservation",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONFIRMÉ\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] }
      },
      "response": [
        {
          "code": 200,
          "name": "Updated",
          "body": "{ \"_id\": \"{{reservationId}}\", \"status\": \"CONFIRMÉ\" }"
        }
      ]
    },
    {
      "name": "Delete Reservation",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] }
      },
      "response": [
        {
          "code": 200,
          "name": "Deleted",
          "body": "{ \"message\": \"Deleted successfully\" }"
        },
        {
          "code": 404,
          "name": "Not Found",
          "body": "{ \"error\": \"Not found\" }"
        }
      ]
    },
    {
      "name": "Get Reservations by Status",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/reservations/status/{{status}}", "host": ["{{baseUrl}}"], "path": ["reservations", "status", "{{status}}"] }
      },
      "response": [
        { "code": 200, "body": "[ { \"_id\": \"64d3b0f12345abcd6789ef11\", \"status\": \"EN_ATTENTE\" } ]" }
      ]
    },
    {
      "name": "Search Reservations",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/reservations/search?user={{userId}}&storage={{storageId}}&status=CONFIRMÉ",
          "host": ["{{baseUrl}}"],
          "path": ["reservations", "search"],
          "query": [
            { "key": "user", "value": "{{userId}}" },
            { "key": "storage", "value": "{{storageId}}" },
            { "key": "status", "value": "CONFIRMÉ" }
          ]
        }
      },
      "response": [
        { "code": 200, "body": "[ { \"_id\": \"64d3b0f12345abcd6789ef11\", \"user\": \"{{userId}}\", \"storage\": \"{{storageId}}\", \"status\": \"CONFIRMÉ\" } ]" }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "userId", "value": "64d39f912345abcd6789ef00" },
    { "key": "storageId", "value": "64d3a0d12345abcd6789ef01" },
    { "key": "reservationId", "value": "64d3b0f12345abcd6789ef11" },
    { "key": "status", "value": "EN_ATTENTE" }
  ]
}