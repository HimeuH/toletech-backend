PORT=3000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# MONGO_URI=mongodb://localhost:27017/toletech  # local dev

NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# Cloudinary (photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payment providers ----
DEFAULT_PAYMENT_PROVIDER=WAVE
DEFAULT_PAYOUT_PROVIDER=WAVE
FRONTEND_URL=http://localhost:4200
BACKEND_URL=https://your-backend-url.com

# Wave Payment Gateway
WAVE_API_KEY=wave_sn_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WAVE_BASE_URL=https://api.wave.com/v1
WAVE_WEBHOOK_SECRET=wave_sn_WHS_xxxxxxxxxxxxxxxxxxxx

# Orange Money Marchands (Senegal)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/sn/v1

# Commission defaults (used when no CommissionConfig entry matches)
COMMISSION_STORAGE_PERCENT=10
COMMISSION_TRANSPORT_PERCENT=15

# SMTP (Brevo recommended)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_EMAIL=your_brevo_login@example.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_NAME=ToleTech
SMTP_FROM_EMAIL=no-reply@toletech.sn

# SMS (Africa's Talking)
SMS_PROVIDER=africastalking
SMS_API_KEY=your_africastalking_api_key
SMS_API_SECRET=TOLETECH   # AT username, not a secret
# SMS_SENDER_ID=TOLETECH  # register with AT for Senegal first

# Channel switch: 'email' or 'sms' (revert by changing back to 'sms')
OTP_CHANNEL=email
NOTIFY_CHANNEL=email

# Rate limiting
RATE_LIMIT_MAX=500
